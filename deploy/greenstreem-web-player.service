[Unit]
Description=GreenStreem Web Player
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/greenstreem-web-player
Environment=GREENSTREEM_HOST=127.0.0.1
Environment=GREENSTREEM_PORT=8097
Environment=GREENSTREEM_SESSION_TTL_SECONDS=43200
ExecStart=/usr/bin/python3 /opt/greenstreem-web-player/server.py
Restart=always
RestartSec=5
User=greenstreem
Group=greenstreem

[Install]
WantedBy=multi-user.target
